# ─────────────────────────────────────────────────────────────
#  Prospecta — configuration
#  Copiez ce fichier en .env.local et renseignez vos clés.
#  Sans clé IA (ANTHROPIC_API_KEY ou OPENROUTER_API_KEY),
#  l'application tourne en MODE DÉMO (données simulées).
# ─────────────────────────────────────────────────────────────

# ── IA (une des deux clés est obligatoire hors démo) ─────────
# Anthropic est utilisé en priorité s'il est configuré, sinon OpenRouter.
# AI_PROVIDER=anthropic|openrouter force le choix quand les deux clés sont présentes.
AI_PROVIDER=

# Anthropic (recommandé : recherche web native de Claude, multi-étapes)
ANTHROPIC_API_KEY=
# Modèle principal (planification, recherche, rédaction)
AI_MODEL=claude-opus-5-5
# Modèle pour les tâches de masse (extraction, scoring). Mettez
# claude-haiku-5-5 pour diviser fortement les coûts.
AI_MODEL_FAST=claude-opus-5-5

# OpenRouter (n'importe quel modèle ; recherche web via le plugin « web »)
OPENROUTER_API_KEY=
# Identifiant exact du modèle sur openrouter.ai/models (à vérifier)
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Modèle des tâches de masse (vide = même modèle)
OPENROUTER_MODEL_FAST=

# ── Base de données ──────────────────────────────────────────
# Vide = Postgres embarqué (PGlite) dans ./data/pglite
# Renseigné = Postgres externe (Supabase, Neon, RDS…). Les tables sont
# créées dans un schéma dédié « prospecta » (aucun conflit avec vos tables).
# Supabase : Connect → « Session pooler » (IPv4), mot de passe inclus.
DATABASE_URL=
# Connexions simultanées vers Postgres
DB_POOL_SIZE=6
# Après cette inactivité (ms), la connexion est vérifiée avant usage (instances serverless suspendues)
DB_IDLE_CHECK_MS=30000

# ── Moteurs de recherche (optionnels, cumulables) ────────────
# Sans clé, la recherche web native de Claude est utilisée.
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# ── Bases de données B2B (optionnelles, cumulables) ──────────
# Entreprises filtrées par secteur / pays / effectif et décideurs identifiés.
APOLLO_API_KEY=
PDL_API_KEY=

# ── Recherche et vérification d'emails (optionnel) ───────────
HUNTER_API_KEY=
# Services de vérification, interrogés en cascade jusqu'à un verdict définitif
ZEROBOUNCE_API_KEY=
NEVERBOUNCE_API_KEY=
MILLIONVERIFIER_API_KEY=
# Vérification SMTP (RCPT TO) : nécessite le port 25 sortant.
SMTP_VERIFY=false
SMTP_VERIFY_FROM=verify@example.com

# ── Envoi des emails ─────────────────────────────────────────
# Boîte « par défaut ». Vous pouvez aussi ajouter plusieurs boîtes depuis
# Paramètres → Boîtes d'envoi (rotation automatique, limites par boîte).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDER_NAME=
SENDER_EMAIL=
# Adresse postale de l'expéditeur (obligatoire en prospection B2B)
SENDER_ADDRESS=
DAILY_SEND_LIMIT=40
# Lecture des réponses et rebonds de la boîte par défaut (IMAP, facultatif)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
# Identifiants IMAP (par défaut ceux du SMTP)
IMAP_USER=
IMAP_PASS=
# URL publique de l'app (liens de désinscription)
APP_URL=http://localhost:3000

# ── Accès à l'application ────────────────────────────────────
# Mot de passe demandé par le navigateur (fortement recommandé en ligne).
# Vide = pas de protection (développement local uniquement).
APP_PASSWORD=
# Identifiant exigé (vide = n'importe quel identifiant avec le bon mot de passe)
APP_USER=

# ── Worker ───────────────────────────────────────────────────
# Le worker tourne dans le serveur Next.js par défaut.
# Mettez false si vous lancez `npm run worker` séparément (Postgres requis).
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=4
# Mode serverless (détecté automatiquement sur Vercel / Lambda) : pas de worker
# permanent, la file avance pendant les requêtes et via /api/cron/tick.
# true / false pour forcer.
SERVERLESS=
# Protège /api/cron/tick (mode serverless)
CRON_SECRET=
# Signe les liens de désinscription (chaîne aléatoire longue, à ne jamais changer)
UNSUBSCRIBE_SECRET=
# Chiffre les mots de passe des boîtes d'envoi en base (par défaut : UNSUBSCRIBE_SECRET).
# Ne jamais le changer après avoir ajouté des boîtes.
ENCRYPTION_KEY=
# Force le mode démo même avec une clé
DEMO_MODE=false
